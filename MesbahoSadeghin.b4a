Private Sub safineBut_Click
	Dim b1 As ImageView = Sender
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(100,b1.Left,b1.Top,b1W+3%x,b1H+1%x)
	Sleep(100)
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	Sleep(100)
	If safSelIdx = 1 Then
		SafFr_Click
	Else
		SafAr_Click
	End If
End Sub

Private Sub anisBut_Click
	Dim b1 As ImageView = Sender
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(100,b1.Left,b1.Top,b1W+3%x,b1H+1%x)
	Sleep(100)
	b1.SetLayoutAnimated(100,b1.Left,b1.Top,b1W,b1H)
	Sleep(100)
	If AnisSelIdx = 1 Then
		Anis1_Click
	Else
		Anis2_Click
	End If
	
End Sub


Private Sub aLastR_Click
	Dim b1 As Button = aLastR
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+2%x,b1H+2%x)
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	Sleep(150)
End Sub

Private Sub LastR_Click
	If Not(popupView) Then
		Dim b1 As Button = LastR
		Dim b1W As Int = b1.Width
		Dim b1H As Int = b1.Height
		b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+2%x,b1H+2%x)
		Sleep(150)
		b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	

		If popupView1 Then
			popupView1 = False
			Activity.RemoveViewAt(popupIndex)
			anisBut.SetVisibleAnimated(150,True)
			safineBut.SetVisibleAnimated(150,True)
			AnisSelStatus.SetVisibleAnimated(150,True)
			SafSelStetus.SetVisibleAnimated(150,True)
		Else
			popupView1 = True
			popupIndex = Activity.NumberOfViews
			anisBut.SetVisibleAnimated(150,False)
			safineBut.SetVisibleAnimated(150,False)
			AnisSelStatus.SetVisibleAnimated(150,False)
			SafSelStetus.SetVisibleAnimated(150,False)
'		Sleep(80)
			Dim p As Panel
			p.Initialize("")
			p.LoadLayout("nMenuNew1")
			If safSelIdx = 1 Then
				safinebookImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"saffr.jpg"))
			Else
				safinebookImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"safar.jpg"))
			End If
			If AnisSelIdx = 1 Then
				anisbookImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"anis1.jpg"))
			Else
				anisbookImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"anis.jpg"))
			End If
			Activity.AddView(p,18%x,LastR.Top - 70%x,80%x,70%x)
			p.Left = 50%x
			p.Top = bookSetting.Top - 35%x
			p.Width = 0
			p.Height = 0
			p.SetLayoutAnimated(150,18%x,LastR.Top - 70%x,80%x,70%x)
		End If
	Else
		bookSetting_Click
	End If
End Sub

Private Sub safinebookImage_Click
	Dim b1 As ImageView = safinebookImage
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+2%x,b1H+4%x)
	Sleep(150)
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	If safSelIdx = 1 Then
		myf.DatabesOpen(s1,myf.booklibAddress,booklst.Get(2),True)
		File.WriteString(File.DirInternalCache,"bookAddr.txt",myf.booklibAddress)
		File.WriteString(File.DirInternalCache,"booksel.txt",booklst.Get(2))
		File.WriteString(File.DirInternalCache,"booktype.txt","8")
		
	Else
		myf.DatabesOpen(s1,myf.booklibAddress,booklst.Get(1),True)
		File.WriteString(File.DirInternalCache,"bookAddr.txt",myf.booklibAddress)
		File.WriteString(File.DirInternalCache,"booksel.txt",booklst.Get(1))
		File.WriteString(File.DirInternalCache,"booktype.txt","8")
	End If
	
	Dim cur As Cursor = s1.ExecQuery("select * from Edameh")
	If cur.RowCount = 1 Then
		cur.Position = 0
		onvanha.search = False
		onvanha.idonvan = cur.GetInt("idonvan")
		onvanha.onvanSel = cur.GetString("onvanSel")
		matnha.edameh = True
		matnha.startItem = cur.GetInt("ItemNumber")
		cur.Close
		File.WriteString(File.DirInternalCache,"onvanha.txt",onvanha.idonvan)
		File.WriteString(File.DirInternalCache,"onvanSel.txt",onvanha.onvanSel)
		StartActivity(matnha)
		myf.SetAnimation("right_left1","right_left")
		LastR_Click
	else if cur.RowCount = 0 Then
		ToastMessageShow("این کتاب قبلا مطالعه نشده است",False)
	End If
End Sub

Private Sub anisbookImage_Click
	Dim b1 As ImageView = anisbookImage
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+2%x,b1H+4%x)
	Sleep(150)
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	If AnisSelIdx = 1 Then
		myf.DatabesOpen(s1,myf.booklibAddress,booklst.Get(0),True)
		File.WriteString(File.DirInternalCache,"bookAddr.txt",myf.booklibAddress)
		File.WriteString(File.DirInternalCache,"booksel.txt",booklst.Get(0))
		File.WriteString(File.DirInternalCache,"booktype.txt","4")
		Dim cur As Cursor = s1.ExecQuery("select * from Edameh")
	Else
		myf.DatabesOpen(s1,myf.booklibAddress,booklst.Get(3),True)
		File.WriteString(File.DirInternalCache,"bookAddr.txt",myf.booklibAddress)
		File.WriteString(File.DirInternalCache,"booksel.txt",booklst.Get(3))
		File.WriteString(File.DirInternalCache,"booktype.txt","4")
		Dim cur As Cursor = s1.ExecQuery("select * from Edameh")
	End If
	
	If cur.RowCount = 1 Then
		cur.Position = 0
		onvanha.search = False
		onvanha.idonvan = cur.GetInt("idonvan")
		onvanha.onvanSel = cur.GetString("onvanSel")
		Motoon.edameh = True
		Motoon.startItem = cur.GetInt("ItemNumber")
		cur.Close
		File.WriteString(File.DirInternalCache,"onvanha.txt",onvanha.idonvan)
		File.WriteString(File.DirInternalCache,"onvanSel.txt",onvanha.onvanSel)
		LastR_Click
		StartActivity(Motoon)
		myf.SetAnimation("right_left1","right_left")
	else if cur.RowCount = 0 Then
		ToastMessageShow("این کتاب قبلا مطالعه نشده است",False)
	End If
	
End Sub