# Apache (cPanel) settings for Mesbah al-Sadeqin — copied to the site root by `npm run build`.

Options -Indexes

# Always HTTPS: service workers, installing and the clipboard all require it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/json .json
AddType text/javascript .js
AddCharset utf-8 .html .js .css .json .webmanifest .txt

# The book data is ~14 MB of JSON; compressed it is about a quarter of that.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # Entry points must be revalidated every time, or updates would never reach installed apps.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Content-hashed files (assets/*-<hash>.js|css, data/<book>/*.<hash>.json) never change.
  <If "%{REQUEST_URI} =~ m#^/assets/# || %{REQUEST_URI} =~ m#^/data/\d+/[^/]+\.[0-9a-f]{10}\.json$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Fonts, images and icons keep their names; the service worker revalidates them on updates.
  <If "%{REQUEST_URI} =~ m#^/(fonts|img|icons)/#">
    Header set Cache-Control "public, max-age=604800"
  </If>

  # The APK is replaced in place on each release.
  <If "%{REQUEST_URI} =~ m#^/download/#">
    Header set Cache-Control "no-cache"
    Header set Content-Disposition "attachment"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
