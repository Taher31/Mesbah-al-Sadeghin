{
  "name": "mesbah-web",
  "private": true,
  "version": "1.2.0",
  "description": "مصباح الصادقین — نسخهٔ وب (PWA) قابل نصب و آفلاین",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.ts",
    "assets": "node scripts/convert-fonts.mjs && python -I scripts/prepare-images.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run data && npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wawoff2": "2.0.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
