<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window before the page appears. The theme's light/dark side is also what the
         WebView reports to the page as prefers-color-scheme, so it follows the system (values-night). -->
    <style name="Theme.Mesbah" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
