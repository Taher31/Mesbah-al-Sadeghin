{"e":[[1,1,"عنوان",1,0],[2,1,"مقدمه",1,0],[3,1,"پیش‌گفتار",1,0],[4,1,"نگاهی گذرا به زندگانی آیت‌الله حاج سیّد حسین یعقوبی قائنی (قدّس‌سره)",1,0],[5,1,"چند تذکّر مهم",1,0],[6,1,"تعقیبات نماز",1,0],[7,1,"تعقیبات مشترکه",0,-1],[8,2,"* ۱. استغفار",1,0],[9,2,"۲. صلوات",1,0],[10,2,"۳. اَللّٰهُمَّ عَرِّفْنی نَفْسَكَ...",1,0],[11,2,"* ۴. اَللّٰهُمَّ كُنْ لِوَلِیِّكَ...",1,0],[12,2,"* ۵. دعای طول عمر",1,0],[13,2,"* ۶. شهادت به توحید",1,0],[14,2,"* ۷. تسبیح حضرت فاطمه (علیها‌السلام)",1,0],[15,2,"* ۸. سلام به معصومین (ع) پس از تسبیح حضرت فاطمه (ع)",1,0],[16,2,"* ۹. سورۀ حمد، آیة الکرسی و آیۀ شهادت و ملک",1,0],[17,2,"* ۱۰. لَقَدْ جاءَكُمْ رَسُولٌ...",1,0],[18,2,"* ۱۱. دوازده مرتبه سورۀ توحید",1,0],[19,2,"* ۱۲. اَللّٰهُمَّ اِنّی اَسْألُكَ مِنْ كُلِّ خَیْرٍ...",1,0],[20,2,"* ۱۳. یا مَنْ لٰا یَشْغَلُهُ سَمْعٌ...",1,0],[21,2,"۱۴. سُبْحانَ مَنْ لٰا یَعْتَدی عَلیٰ اَهْلِ...",1,0],[22,2,"* ۱۵. لعن بر اعداء پس از نماز",1,0],[23,2,"* ۱۶. سلام بر پیامبر اکرم (صلی‌الله علیه وآله)",1,0],[24,2,"۱۷. تسبیحات اربعه برای مسافر",1,0],[25,1,"تعقیبات نماز صبح",0,-1],[26,2,"* ۱. بِسْمِ اللّٰهِ وَ صَلَّى اللّٰهُ عَلیٰ مُحَمَّدٍ وَ آلِه، وَ اُفَوِّضُ...",1,0],[27,2,"* ۲. زیارت حضرت صاحب الامر (عج)",1,0],[28,2,"* ۳. حمد بر چهار نعمت",1,0],[29,2,"* ۴. سُبْحانَ اللّٰهِ الْعَظیمِ وَ بِحَمْدِه، لٰا حَوْلَ...",1,0],[30,2,"* ۵. سُبْحانَ اللّٰهِ الْعَظیمِ وَ بِحَمْدِه، اَسْتَغْفِرُ الله...",1,0],[31,2,"۶. یا فَتّاحُ",1,0],[32,2,"۷. دعای عهد",1,0],[33,2,"* ۸. دعای صباح",1,1],[34,2,"* ۹. اَلْحَمْدُ لِلّٰهِ عَلیٰ كُلِّ نِعْمَةٍ، وَ اَسْألُ اللّٰهَ مِنْ كُلِّ خَیْرٍ ...",1,1],[35,2,"۱۰. لٰا اِلهَ اِلَّا اللّٰهُ الْمَلِكُ...",1,1],[36,1,"دعاهای صبح و شام",0,-1],[37,2,"* ۱. بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحیم، لٰا حَوْلَ وَ لٰا قُوَّةَ...",1,1],[38,2,"۲. اَللّٰهُمَّ اِنّی اَسْألُكَ بِحَقِّ مُحَمَّدٍ وَ آلِ مُحَمَّدٍ عَلَیْكَ...",1,1],[39,2,"* ۳. اَللّٰهمَّ اجْعَلْنی فی دِرْعِكَ الْحَصینَةِ ...",1,1],[40,2,"* ۴. ذکر قبل از طلوع و غروب خورشید",1,1],[41,2,"* ۵. اَللّٰهُمَّ مُقَلِّبَ الْقُلُوبِ وَالْاَبْصارِ ...",1,1],[42,2,"۶. اَللّٰهُمَّ اَنْتَ رَبّی...",1,1],[43,2,"* ۷. دعای مجرّب",1,1],[44,2,"* ۸. دعای عشرات",1,1],[45,1,"برخی از تعقیبات مختصه سایر نمازها",0,-1],[46,2,"الف) نماز عصر",1,1],[47,2,"ب) نماز مغرب",0,-1],[48,3,"* نماز غفیله",1,1],[49,2,"ج) نماز عشا",1,1],[50,1,"دعاهاى سجدۀ آخر نماز",0,-1],[51,2,"۱. یا وَلِىَّ الْعافِیَةِ...",1,1],[52,2,"۲. یا مَنْ كَتَبَ عَلیٰ نَفْسِهِ الرَّحْمَة...",1,1],[53,2,"۳. اَللّٰهُمَّ صَلِّ عَلی... وَافْعَلْ بِنا...",1,1],[54,2,"۴. اَللّٰهُمَّ صَلِّ عَلی... وَامْلَأْ قَلْبی...",1,1],[55,2,"۵. یا لَطیفُ، اِرْحَمْ...",1,1],[56,1,"دعاهاى قنوت",0,-1],[57,2,"۱. رَبِّ اغْفِرْ وَارْحَمْ وَ تَجاوَز...",1,1],[58,2,"۲. اَللّٰهُمَّ اغْفِرْ لَنا وَارْحَمْنا...",1,1],[59,2,"۳. لٰا اِلٰهَ اِلَّا اللّٰهُ الْحَلیمُ الْكَریم...",1,1],[60,2,"۴. اَللّٰهُمَّ اِنّی اَسْألُكَ بِحَقِّ فاطِمَةَ...",1,1],[61,2,"۵. رَبَّنا آتِنا فِى الدُّنْیا حَسَنَةً...",1,1],[62,2,"۶. رَبِّ اغْفِرْ وَارْحَمْ...",1,1],[63,2,"۷. رَبِّ اِنّی فَقیرٌ بِرَحْمَتِكَ...",1,1],[64,2,"۸. رَبِّ زِدْنی عِلْمًا...",1,1],[65,2,"۹. رَبَّنَا اغْفِرْ لی وَ لِوالِدَىَّ...",1,1],[66,2,"۱۰. یا مَنْ اَظْهَرَ الْجَمیلَ...",1,1],[67,2,"* ۱۱. اَللّٰهُمَّ صَلِّ عَلیٰ... وَ عَجِّلْ لِوَلِیِّكَ الْمَهْدىّ...",1,1],[68,2,"* ۱۲. اَللّٰهُمَّ صَلِّ عَلیٰ... وَ عَجِّلْ لِوَلِیِّكَ الْفَرَج...",1,1],[69,2,"۱۳. اَللّٰهُمَّ اِنّی اَسْألُكَ حُبَّكَ...",1,1],[70,2,"۱۴. اَللّٰهُمَّ اِنّی اَسْألُكَ الْعَفْوَ...",1,1],[71,2,"۱۵. اَللّٰهُمَّ صَلِّ عَلیٰ... وَ عَجِّلْ فَرَجَ آلِ مُحَمَّدٍ...",1,1],[72,2,"۱۶. اَللّٰهُمَّ صَلِّ عَلیٰ...وَ آلِ مُحَمَّدٍ وَ سَلِّمْ وَ عَجِّلْ فَرَجَهُمْ...",1,1],[73,2,"۱۷. اِلٰهَنا غَیِّرْ سُوءَ حالِنا...",1,1],[74,2,"۱۸. اَللّٰهُمَّ اِنّی اَسْألُكَ الْاَمْنَ...",1,1],[75,2,"۱۹. اَللّٰهُمَّ صَلِّ عَلیٰ... وَ صَلِّ عَلیٰ جَمیعِ الْاَنْبِیاءِ وَالْمُرْسَلینَ...",1,1],[76,1,"اعمال هر روز",0,-1],[77,2,"* ۱. تلاوت قرآن",1,1],[78,2,"* ۲. اَلْحَمْدُ لِلّٰهِ عَلیٰ كُلِّ نِعْمَةٍ كانَت...",1,1],[79,2,"۳. اَلْحَمْدُ لِلّٰهِ رَبِّ الْعالَمینَ كَثیرًا...",1,2],[80,2,"۴. سُبْحانَ اللّٰهِ وَالْحَمْدُ لِلّٰ