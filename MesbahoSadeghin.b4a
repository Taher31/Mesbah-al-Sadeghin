Sub Activity_KeyPress (KeyCode As Int) As Boolean 'Return True to consume the event
	If KeyCode = KeyCodes.KEYCODE_BACK Then
		If popupView Then
			bookSetting_Click
			Return True
		Else If popupView1 Then
			LastR_Click
			Return True
		Else
			Activity.Finish
			Return True
		End If
	End If
	Return False
End Sub
