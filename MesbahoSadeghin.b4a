Private Sub eata_Click
	Dim b1 As Button = eata
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W-3%x,b1H-1%x)
	Sleep(150)
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	Dim browserIntent As Intent
	browserIntent.Initialize(browserIntent.ACTION_VIEW, "https://eitaa.com/sadeghin_ir")
	StartActivity(browserIntent)
End Sub

Private Sub safineImage_Click
	Dim b1 As ImageView = safineImage
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+1%x,b1H+1%x)

	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	If safSelIdx = 0 Then
		safSelIdx = 1
		File.WriteString(File.DirInternal,"safSelIdx",safSelIdx)
		safineImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut.png"))
	Else
		safSelIdx = 0
		File.WriteString(File.DirInternal,"safSelIdx",safSelIdx)
		safineImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut1.png"))
	End If
	If safSelIdx = 1 Then
		SafSelStetus.Text = "(فارسی)"
		selSafBname.Text = "فارسی"
		safineBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"safinehB1.png"))
	Else
		SafSelStetus.Text = "(عربی)"
		selSafBname.Text = "عربی"
		safineBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"safinehB.png"))
	End If
	
	
	
	
End Sub

Private Sub anisImage_Click
	Dim b1 As ImageView = Sender
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+1%x,b1H+1%x)

	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	If AnisSelIdx = 0 Then
		AnisSelIdx = 1
		File.WriteString(File.DirInternal,"AnisSelIdx",AnisSelIdx)
		anisImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut.png"))
	Else
		AnisSelIdx = 0
		File.WriteString(File.DirInternal,"AnisSelIdx",AnisSelIdx)
		anisImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut1.png"))
	End If
	If AnisSelIdx = 1 Then
		AnisSelStatus.Text = "(با ترجمه)"
		selAnBname.Text = "با ترجمه"
		anisBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"anisB1.png"))
	Else
		AnisSelStatus.Text = "(بدون ترجمه)"
		selAnBname.Text = "بدون ترجمه"
		anisBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"anisB.png"))
	End If
	
End Sub
Private Sub bookSetting_Click
	If Not(popupView1) Then
		Dim b1 As Button = bookSetting
		Dim b1W As Int = b1.Width
		Dim b1H As Int = b1.Height
		b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+2%x,b1H+2%x)
		Sleep(150)
		b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	
	
		If popupView Then
			popupView = False
			Activity.RemoveViewAt(popupIndex)
			anisBut.SetVisibleAnimated(150,True)
			safineBut.SetVisibleAnimated(150,True)
			AnisSelStatus.SetVisibleAnimated(150,True)
			SafSelStetus.SetVisibleAnimated(150,True)
		Else
			popupView = True
			popupIndex = Activity.NumberOfViews
			anisBut.SetVisibleAnimated(150,False)
			safineBut.SetVisibleAnimated(150,False)
			AnisSelStatus.SetVisibleAnimated(150,False)
			SafSelStetus.SetVisibleAnimated(150,False)
'		Sleep(80)
			Dim p As Panel
			p.Initialize("")
			p.LoadLayout("nMenuNew")

			Activity.AddView(p,2%x,bookSetting.Top - 70%x,80%x,70%x)
			p.Left = 50%x
			p.Top = bookSetting.Top - 35%x
			p.Width = 0
			p.Height = 0
			p.SetLayoutAnimated(150,2%x,bookSetting.Top - 70%x,80%x,70%x)

			If AnisSelIdx = 1 Then
				selAnBname.Text = "با ترجمه"
				anisImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut.png"))
			Else
				anisImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut1.png"))
				selAnBname.Text = "بدون ترجمه"
			End If

			If safSelIdx = 1 Then
				safineImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut.png"))
				selSafBname.Text = "فارسی"
			Else
				safineImage.SetBackgroundImage(LoadBitmap(File.DirAssets,"selbut1.png"))
				selSafBname.Text = "عربی"
			End If
		End If
	Else
		LastR_Click
	End If
End Sub

Private Sub aboutIcon_Click
	Dim b1 As Button = aboutIcon
	Dim b1W As Int = b1.Width
	Dim b1H As Int = b1.Height
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W+2%x,b1H+2%x)
	Sleep(150)
	b1.SetLayoutAnimated(150,b1.Left,b1.Top,b1W,b1H)
	Dim message As String
	message =CRLF& File.ReadString(File.DirAssets,"about1.txt")&CRLF
	'"بسم الله الرحمن الرحیم"&CRLF& "برنامهٔ صادقین (نسخهٔ ۱)"&CRLF&"این برنامه به منظور حفظ، نشر و ترویج آثار و سیره‌ی عالم ربانی حضرت آیت‌الله حاج سید حسین یعقوبی قائنی (قدّس‌سرّه الشریف)، تدوین شده که تقدیم حضور علاقه‌مندان و ارادتمندان ایشان می‌‌گردد."&CRLF&"این نرم افزار دربردارنده دو اثر ارزشمند زیر می‌باشد:"&CRLF&"کتاب انیس الصادقین: مجموعه‌ای ارزشمند از رهنمودهای آن عالم ربانی در زمینهٔ ادعیه و اذکار، که ثمرهٔ سال‌ها سلوک معنوی و تجربهٔ عبادی ایشان است."&CRLF&"کتاب سفینه الصادقین: شرح احوال و زندگینامه‌یٔ آن بزرگوار، که گوشه‌هایی از سیرهٔ عملی و اخلاقی ایشان را در معرض دید علاقه‌مندان قرار می‌دهد."&CRLF&"این اثر به سفارش کانال صادقین (sadeghin_ir) تهیه شده و از شهریورماه ۱۴۰۵ هجری شمسی، به‌صورت رایگان در اختیار عموم علاقه‌مندان قرار می‌گیرد."&CRLF&CRLF&	"امیدواریم با ارائهٔ نظرات، پیشنهادات و انتقادات سازنده‌ی خویش، ما را در مسیر ارتقا و بهینه‌سازی هرچه بیشتر این اثر یاری فرمایید."&CRLF&CRLF&"راه‌های ارتباطی:"&CRLF&"-مدیر کانال: [Yaghobi01@gmail.com]"&CRLF&"-برنامه‌نویس: [Anisbook@iran.ir]"&CRLF&CRLF&CRLF&CRLF
	



	Dim dia As CustomDialog2
	Dim sv As ScrollView
	Dim lbl As Label
	Dim pnl As Panel

	' --- ساخت پنل داخلی برای Label (تا ScrollView بتواند محتوا را بفهمد) ---
	pnl.Initialize("pnl")

	' --- ساخت لیبل ---
	lbl.Initialize("lbl")
	lbl.Typeface = Typeface.LoadFromAssets("Vazirmatn-Regular.ttf")
	lbl.Text = message
	lbl.TextSize = 18
	lbl.Width = 70%x
	myf.setLineSpace(lbl, 1.25)
	lbl.Gravity = Gravity.RIGHT
	lbl.TextColor = 0xffcaa57c'a7d371

	sv.Initialize(1350dip)
	Dim gd As GradientDrawable
	' با استفاده از GradientDrawable، رنگ پس‌زمینه و شعاع گوشه را تعیین می‌کنیم
	gd.Initialize("TL_BR", Array As Int( 0xFF021c1a, 0xff052324))
	sv.Panel.Background = gd
	sv.Panel.AddView(lbl, 10%x, 0%x, lbl.Width+10%x, lbl.Height)
	
	Dim jo = sv As JavaObject
	jo.RunMethod("setVerticalScrollbarPosition", Array As Object (1))   ' position left
	jo.RunMethod("setScrollBarSize", Array(DipToCurrent(10)))
	
	Dim r As Reflector
	r.Target = sv
	r.Target = r.GetField("mScrollCache")
	r.Target = r.GetField("scrollBar")
	Dim cd As ColorDrawable
	cd.Initialize(0xffe0bb92, 5dip)
	myf.ChangeScrollbarColor(sv, cd)
	

	dia.AddView(sv, 95%x, 100%y)
	dia.Show("", "", "", "", Null)
'	Dim dia As CustomDialog2
'	Dim lbl As Label
'	lbl.Initialize("lbl")
'	lbl.Typeface = Typeface.LoadFromAssets("Vazirmatn-Light.ttf")
'	lbl.Text = message
'	lbl.TextSize = 18
'	myf.setLineSpace(lbl,1)
'	lbl.Gravity = Gravity.CENTER
'	dia.AddView(lbl, 88%x,100%y)
'	dia.Show("بسم الله الرحمن الرحیم", "", "", "", Application.Icon)
	
	
'	Dim sf As Object = Msgbox2Async(message,title, "", "", "", Application.Icon,True)
'	FixMsgboxColor(sf, 0xffa7d371) ' رنگ پس‌زمینه را اینجا تعیین کنید
'	SetTextColor(sf, Colors.Black, Colors.Black, Colors.Black)
End Sub

