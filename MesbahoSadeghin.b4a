Sub Activity_Create(FirstTime As Boolean)
	'Do not forget to load the layout file created with the visual designer. For example:
'	pageSel = 5
	Activity.RemoveAllViews
	myf.Loading(SetData)
'	ifSts.Initialize(Me, "SPIFStatus")
'	SPPing.Initialize(Me, "SPPing")
	
	Provider.Initialize
'	matnha.klmc = False
'	trCount = 0
'	PlayTimer.Enabled = False
'	DmTimer.Enabled = False
	
	If File.Exists(File.DirInternal,"AnisSelIdx") Then
		AnisSelIdx = File.ReadString(File.DirInternal,"AnisSelIdx")
	Else
		AnisSelIdx = 1
		File.WriteString(File.DirInternal,"AnisSelIdx",AnisSelIdx)
	End If

	If File.Exists(File.DirInternal,"safSelIdx") Then
		safSelIdx = File.ReadString(File.DirInternal,"safSelIdx")
	Else
		safSelIdx = 1
		File.WriteString(File.DirInternal,"safSelIdx",safSelIdx)
	End If
	
	Activity.LoadLayout("backSubMenu")
	
	VersionN.Text = Application.VersionName

	If AnisSelIdx = 1 Then
		AnisSelStatus.Text = "(با ترجمه)"
		anisBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"anisB1.png"))
	Else
		AnisSelStatus.Text = "(بدون ترجمه)"
		anisBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"anisB.png"))
	End If

	If safSelIdx = 1 Then
		SafSelStetus.Text = "(فارسی)"
		safineBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"safinehB1.png"))
	Else
		SafSelStetus.Text = "(عربی)"
		safineBut.SetBackgroundImage(LoadBitmap(File.DirAssets,"safinehB.png"))
	End If
	
		
	
		
	myf.Loading(SetData)

	myf.booklibAddress = File.DirInternal & "/ASSAR/"
		
		
	booklst.Initialize
	Wait For (File.ListFilesAsync(myf.booklibAddress)) Complete (Success As Boolean, Files As List)
	booklst.AddAll(Files)
		
	Dim i As Int = 0
	Do While i < booklst.Size
		Dim path As String = booklst.Get(i)
		If path.SubString(path.Length-5) = ".book" Then
			i = i+1
		Else
			booklst.RemoveAt(i)
		End If
	Loop
	booklst.Sort(True)
	File.WriteList(File.DirInternalCache,"booklst.txt",booklst)
	
End Sub
Private Sub AdjustLblSize(lbl As Label)
	Dim w As Int
	Dim h As Int
	Dim su As StringUtils
	Dim cvs As B4XCanvas
	Dim lines() As String = Regex.Split(CRLF, lbl.Text)
	Dim fnt As B4XFont = xui.CreateFont(lbl.Typeface, lbl.TextSize)
    
	h = su.MeasureMultilineTextHeight(lbl, lbl.Text) + lbl.Padding(1) + lbl.Padding(3)
    
	cvs.Initialize(lbl)
	w = 0
	For idx = 0 To lines.Length - 1
		Dim wLine As Int = cvs.MeasureText(lines(idx), fnt).Width + lbl.Padding(0) + lbl.Padding(2) + 5dip
		If w < wLine Then w = wLine
	Next
	cvs.Release
    
	lbl.Width = w
	lbl.Height = h
End Sub
